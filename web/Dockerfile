FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:4101
ARG NEXT_PUBLIC_PROCUREMENT_API_URL=http://localhost:4102
ENV NEXT_PUBLIC_INVENTORY_API_URL=$NEXT_PUBLIC_INVENTORY_API_URL
ENV NEXT_PUBLIC_PROCUREMENT_API_URL=$NEXT_PUBLIC_PROCUREMENT_API_URL
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app ./
EXPOSE 3000
CMD ["npm", "run", "start"]